{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://faaruun-hin-callisu.local/schema/storyboard.schema.json",
    "title": "Heritage Short Storyboard Contract",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "project",
      "design_intent",
      "style_block",
      "character",
      "tts",
      "music",
      "shots"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      },
      "project": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "english_title",
          "logline",
          "target_duration_s",
          "end_card_duration_s",
          "fps",
          "narration_language",
          "subtitle_language"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "english_title": { "type": "string", "minLength": 1 },
          "logline": { "type": "string", "minLength": 10 },
          "target_duration_s": { "type": "integer", "minimum": 60, "maximum": 90 },
          "end_card_duration_s": { "type": "integer", "minimum": 2, "maximum": 5 },
          "fps": { "type": "integer", "enum": [24, 25, 30] },
          "narration_language": { "type": "string", "enum": ["om", "am", "en"] },
          "subtitle_language": { "type": "string", "enum": ["en"] }
        }
      },
      "design_intent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience", "viewing_context", "target_feeling"],
        "properties": {
          "audience": { "type": "string", "minLength": 10 },
          "viewing_context": { "type": "string", "minLength": 5 },
          "target_feeling": { "type": "string", "minLength": 10 }
        }
      },
      "style_block": {
        "type": "string",
        "minLength": 20
      },
      "character": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "is_real_person",
          "description",
          "reference_seed",
          "reference_prompts"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "is_real_person": { "type": "boolean" },
          "description": { "type": "string", "minLength": 20 },
          "reference_seed": { "type": "integer", "minimum": 0 },
          "reference_prompts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 10 }
          }
        }
      },
      "tts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "voice_name",
          "style_instruction",
          "languages_to_benchmark"
        ],
        "properties": {
          "model": { "type": "string", "minLength": 1 },
          "voice_name": { "type": "string", "minLength": 1 },
          "style_instruction": { "type": "string", "minLength": 5 },
          "languages_to_benchmark": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["om", "am", "en"] }
          }
        }
      },
      "music": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "candidates_per_cue",
          "selected_seed",
          "bpm",
          "key",
          "instrumental",
          "cues"
        ],
        "properties": {
          "model": { "type": "string", "minLength": 1 },
          "candidates_per_cue": { "type": "integer", "minimum": 1, "maximum": 8 },
          "selected_seed": { "type": "integer", "minimum": 0 },
          "bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
          "key": { "type": "string", "minLength": 1 },
          "instrumental": { "type": "boolean" },
          "cues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "duration_s", "caption"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "duration_s": { "type": "integer", "minimum": 30, "maximum": 60 },
                "caption": { "type": "string", "minLength": 15 }
              }
            }
          }
        }
      },
      "shots": {
        "type": "array",
        "minItems": 8,
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "beat",
            "reason",
            "shot_size",
            "duration_s",
            "has_character",
            "motion_engine",
            "image_prompt",
            "motion_prompt",
            "ken_burns",
            "seed",
            "narration",
            "music_cue"
          ],
          "properties": {
            "id": { "type": "string", "pattern": "^s\\d{2}$" },
            "beat": { "type": "string", "minLength": 2 },
            "reason": { "type": "string", "minLength": 10 },
            "shot_size": {
              "type": "string",
              "enum": [
                "extreme-wide",
                "wide",
                "medium",
                "medium-close-up",
                "close-up",
                "extreme-close-up",
                "insert"
              ]
            },
            "duration_s": { "type": "integer", "minimum": 4, "maximum": 12 },
            "has_character": { "type": "boolean" },
            "motion_engine": {
              "type": "string",
              "enum": ["wan2.2", "hunyuan1.5", "ken_burns"]
            },
            "image_prompt": { "type": "string", "minLength": 15 },
            "motion_prompt": { "type": "string", "minLength": 5 },
            "ken_burns": {
              "type": "object",
              "additionalProperties": false,
              "required": ["zoom_start", "zoom_end", "pan_x", "pan_y"],
              "properties": {
                "zoom_start": { "type": "number", "minimum": 1.0, "maximum": 1.3 },
                "zoom_end": { "type": "number", "minimum": 1.0, "maximum": 1.3 },
                "pan_x": { "type": "number", "minimum": -0.2, "maximum": 0.2 },
                "pan_y": { "type": "number", "minimum": -0.2, "maximum": 0.2 }
              }
            },
            "seed": { "type": "integer", "minimum": 0 },
            "narration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["om", "am", "en"],
              "properties": {
                "om": { "type": "string" },
                "am": { "type": "string" },
                "en": { "type": "string" }
              }
            },
            "music_cue": { "type": "string", "minLength": 3 }
          }
        }
      }
    }
  }